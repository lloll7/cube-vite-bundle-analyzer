{
  "name": "vite-bundle-analyzer-lin",
  "version": "1.0.0",
  "description": "Vite/Rollup 打包分析插件：体积统计、source 归因与可视化报告",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "bin": {
    "vite-bundle-analyzer-lin": "dist/cli-bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build",
    "client:build": "npm --prefix client/cube-vite-bundle-analyzer-client run build",
    "precompile": "npm run client:build && node --experimental-strip-types pre-compile.ts",
    "analyze": "node --experimental-transform-types src/cli-bin.ts",
    "real:build": "vite build --config cube-zigbee-bridge-ultra-web/vite.config.ts",
    "real:dev": "vite --config cube-zigbee-bridge-ultra-web/vite.config.ts",
    "test": "vitest run",
    "test:real": "set ANALYZER_MODE=json&& cd cube-zigbee-bridge-ultra-web && npm run build",
    "test:verify": "node scripts/verify-stats.mjs"
  },
  "author": "lin",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/your-org/vite-bundle-analyzer-lin.git"
  },
  "keywords": [
    "vite",
    "rollup",
    "bundle",
    "analyzer",
    "bundle-analyzer",
    "体积分析"
  ],
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "vite": ">=3"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "rollup": "^4.62.2",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@rollup/pluginutils": "^5.4.0"
  }
}
